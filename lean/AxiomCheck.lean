/-! THE WALK (lean #32's second lens, its second re-lens C2N-1 to C2N-3, its third C3N-1, C3N-2, C3N-4, C3N-9, its
fourth C4N-4, C4N-6; S1, 2026-09-29). Beside the list above, every constant the walked modules declare is read from
the ENVIRONMENT, the elaborated declarations, never the text, and four kinds are named, each on an `axiom walk: NOT
ALLOWED:` line:
- an `axiom`;
- a constant whose compiled code is not its definition's: one the compiler replaces by another function
  (`implemented_by`, `Lean.Compiler.getImplementedBy?`, `Lean/Compiler/ImplementedByAttr.lean:67–68`), links to foreign
  code (`extern`, `Lean.isExtern`, `Lean/Compiler/ExternAttr.lean:119–120`) or fills from an initializer (`@[init]`,
  `Lean.hasInitAttr`, `Lean/Compiler/InitAttr.lean:143–144`: compiled as an external value, `Lean/Compiler/LCNF/ToDecl.lean:152–155`),
  however the attribute was set (the attribute's own syntax, a `run_cmd`, or the term `unsafe e`, whose elaborator sets
  `implemented_by` on an auxiliary, `Lean/Elab/BuiltinNotation.lean:562–578`);
- an `_unsafe_rec` constant that is not a partial definition. The compiler takes the code of any constant of that name
  for the definition it names (`Lean/Compiler/LCNF/ToDecl.lean:100–107`); the elaborator's own copy, made from the
  definition's code, is a partial definition (`Lean/Elab/PreDefinition/Basic.lean:255–295`), so only a hand-made one is named;
- a theorem whose axioms (`collectAxioms`, read from each module's exported table, `Lean/Util/CollectAxioms.lean:113–149`)
  leave Lean's three.
The attributes are read from the entries of the module that declares the constant (`Lean/Attributes.lean:306–318`) and
set only there (`291`, `325`), so the walked modules hold every one their constants carry. A proven `@[csimp]`
replacement is the compiler's trusted step and is not named. The walked modules are every module of `BsvScript`,
`BsvChain` and `Bsvs` the libraries build (the imports above are library modules, all built by `lake build`'s default targets;
`Bsvs.Main`, the executable's root, is not among them, so it is not imported: an import of it would read an olean only
`lake build bsvs` writes, so on a fresh tree the axiom leg would go RED `[D]` (C3N-1; no run met such a tree); the text
scan still reads its source), and `Test.OpNames`, the generated table `Bsvs.Trace` imports. The tree's
`tools/axiom_check.py` judges these lines: its leg is RED unless the walk's line appears once with 0 axioms, 0 compiler
overrides and 0 dependencies outside Lean's three, as many modules as the sources it walks and at least as many theorems
as the list holds, and RED on any `axiom walk: NOT ALLOWED:` line; it pins this text by its SHA-256 (`WALK_SHA256`). A
theorem or an axiom that a spelling hides from the text scan is still walked; an `example` leaves nothing in the
environment and stays the text check's, and a declaration added with the kernel's check skipped carries no axiom, so
only the toolchain's `leanchecker`, not run here, would find it. -/
open Lean Elab Command in
#eval show CommandElabM Unit from do
  let env ← getEnv
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mods := env.allImportedModuleNames
  let ours (m : Name) : Bool := (`BsvScript).isPrefixOf m || (`BsvChain).isPrefixOf m || (`Bsvs).isPrefixOf m || m == `Test.OpNames
  let inScope (n : Name) : Bool :=
    match env.getModuleIdxFor? n with
    | some i => match mods[i.toNat]? with
      | some m => ours m
      | none => false
    | none => false
  let (nconst, thms, axs, over) := env.constants.fold
    (init := ((0 : Nat), (#[] : Array Name), (#[] : Array Name), (#[] : Array String)))
    fun (acc : Nat × Array Name × Array Name × Array String) n ci =>
      let (c, ts, as, ov) := acc
      if !inScope n then acc
      else
        let ov := match Compiler.getImplementedBy? env n with
          | some f => ov.push s!"{n} is implemented_by {f}"
          | none => if isExtern env n then ov.push s!"{n} is extern" else ov
        let ov := if hasInitAttr env n then ov.push s!"{n} has an init attribute" else ov
        let ov := match n, ci with
          | .str _ "_unsafe_rec", .defnInfo d =>
            if d.safety == .partial then ov else ov.push s!"{n} is an _unsafe_rec the elaborator did not make"
          | .str _ "_unsafe_rec", _ => ov.push s!"{n} is an _unsafe_rec the elaborator did not make"
          | _, _ => ov
        match ci with
        | .axiomInfo _ => (c + 1, ts, as.push n, ov)
        | .thmInfo _ => (c + 1, ts.push n, as, ov)
        | _ => (c + 1, ts, as, ov)
  let mut deps : Array String := #[]
  for t in thms do
    for a in (← collectAxioms t) do
      unless allowed.contains a do deps := deps.push s!"{t} depends on {a}"
  let nmods := (mods.filter ours).size
  logInfo m!"axiom walk: {nmods} modules of BsvScript, BsvChain, Bsvs and Test.OpNames, {nconst} constants, {thms.size} theorems, {axs.size} axioms, {over.size} compiler overrides (implemented_by, extern, init, a hand-made _unsafe_rec), {deps.size} dependencies outside Lean's three"
  for b in axs.map (s!"{·} is an axiom") ++ over ++ deps do logInfo m!"axiom walk: NOT ALLOWED: {b}"
