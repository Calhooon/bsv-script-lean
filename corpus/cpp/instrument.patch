+using bytes = std::vector<uint8_t>;
+
+// What a check asserts about one EvalScript call. Unset fields are not asserted.
+struct Expect {
+    std::optional<ScriptError> error;           // the exact status asserted (SCRIPT_ERR_OK for success)
+    bool fails = false;                         // the check asserts status != SCRIPT_ERR_OK
+    std::optional<size_t> stack_size;           // stack.size()
+    std::optional<std::vector<bytes>> stack;    // every element, bottom first
+    std::optional<bytes> stack_top;             // stack.stacktop(-1)
+    std::optional<size_t> top_len;              // stack.stacktop(-1).size()
+    std::vector<std::tuple<int, size_t, uint8_t>> bytes_at; // (stacktop index, offset, byte)
+    std::optional<uint64_t> stack_limit;        // the LimitedStack's byte limit the call ran under
+    const char* note = nullptr;                 // what the check asserts beyond these, or why it asserts nothing
+    std::vector<std::pair<int, bytes>> elems_at; // (index, the element's exact bytes)
+    std::vector<std::pair<int, bytes>> nums_at;  // (index, a number's encoding): the element equals it as a number
+    const char* drawn = nullptr;                // where the call's keys or signatures are drawn at run time
+    std::optional<long long> loop;              // the loop index of a call made in a loop with no table
+    bool concurrent = false;                    // one of several calls made at once on threads
+};
+
+inline std::string hex(const uint8_t* p, size_t n) {
+    static const char* d = "0123456789abcdef";
+    std::string s;
+    s.reserve(2 * n);
+    for (size_t i = 0; i < n; ++i) {
+        s += d[p[i] >> 4];
+        s += d[p[i] & 15];
+    }
+    return s;
+}
+
+// An element: hex up to 4096 bytes; above, its runs of equal bytes (at most 4096 runs),
+// else its length and sha256 only (then the entry is not replayable and the reader says so).
+inline std::string elem(const uint8_t* p, size_t n) {
+    if (n <= 4096) return "\"" + hex(p, n) + "\"";
+    std::string runs;
+    size_t count = 0;
+    for (size_t i = 0; i < n && count <= 4096;) {
+        size_t j = i;
+        while (j < n && p[j] == p[i]) ++j;
+        if (count) runs += ",";
+        runs += "[\"" + hex(p + i, 1) + "\"," + std::to_string(j - i) + "]";
+        ++count;
+        i = j;
+    }
+    if (count <= 4096) return "{\"len\":" + std::to_string(n) + ",\"runs\":[" + runs + "]}";
+    uint8_t h[CSHA256::OUTPUT_SIZE];
+    CSHA256().Write(p, n).Finalize(h);
+    return "{\"len\":" + std::to_string(n) + ",\"sha256\":\"" + hex(h, sizeof h) + "\"}";
+}
+inline std::string elem(const bytes& v) { return elem(v.data(), v.size()); }
+
+inline std::string stack_json(const LimitedStack& s) {
+    std::string r = "[";
+    for (size_t i = 0; i < s.size(); ++i) {
+        const auto& e = s.at(i).GetElement();
+        if (i) r += ",";
+        r += elem(e);
+    }
+    return r + "]";
+}
+
+// The LimitedStack's byte limit (limitedstack.h:87, private) is read through an explicit instantiation, where
+// access checking does not apply ([temp.spec.general]/6), so the pinned header is not touched. Every entry
+// carries the limit its call ran under; a child stack (the altstack) is held to its parent's
+// (limitedstack.cpp:194-206).
+template <typename Tag, typename Tag::type M>
+struct Reach {
+    friend typename Tag::type get(Tag) { return M; }
+};
+struct MaxStackSizeTag {
+    using type = uint64_t LimitedStack::*;
+    friend type get(MaxStackSizeTag);
+};
+template struct Reach<MaxStackSizeTag, &LimitedStack::maxStackSize>;
+inline uint64_t stack_limit(const LimitedStack& s) {
+    const LimitedStack* root = s.getParentStack() ? s.getParentStack() : &s;
+    return root->*get(MaxStackSizeTag{});
+}
+
+inline std::string rel(const char* path) {
+    std::string p{path};
+    const auto k = p.rfind("src/test/");
+    return k == std::string::npos ? p : p.substr(k);
+}
+
+// The checker's fields (interpreter.h:78-82, private) are read the same way, so an entry carries the
+// transaction its checker signs over.
+struct TxToTag { using type = const CTransaction* TransactionSignatureChecker::*; friend type get(TxToTag); };
+struct NInTag { using type = unsigned int TransactionSignatureChecker::*; friend type get(NInTag); };
+struct AmountTag { using type = const Amount TransactionSignatureChecker::*; friend type get(AmountTag); };
+template struct Reach<TxToTag, &TransactionSignatureChecker::txTo_>;
+template struct Reach<NInTag, &TransactionSignatureChecker::nIn_>;
+template struct Reach<AmountTag, &TransactionSignatureChecker::amount_>;
+
+// The checker: "base" (BaseSignatureChecker), "tx" (TransactionSignatureChecker or its Mutable form), or the
+// class name of a test's own checker (its definition is cited in the inventory); a checker derived from
+// TransactionSignatureChecker also carries the transaction, the input and the amount.
+inline std::string checker_json(const BaseSignatureChecker& c) {
+    const std::type_info& t = typeid(c);
+    std::string name;
+    if (t == typeid(BaseSignatureChecker)) name = "base";
+    else if (t == typeid(TransactionSignatureChecker) || t == typeid(MutableTransactionSignatureChecker)) name = "tx";
+    else {
+        int status = 0;
+        char* d = abi::__cxa_demangle(t.name(), nullptr, nullptr, &status);
+        name = d ? d : t.name();
+        std::free(d);
+        if (const auto k = name.rfind("::"); k != std::string::npos) name = name.substr(k + 2);
+    }
+    std::string r = ",\"checker\":\"" + name + "\",\"tx_version\":" + std::to_string(c.Version());
+    if (const auto* tc = dynamic_cast<const TransactionSignatureChecker*>(&c)) {
+        r += ",\"tx\":\"" + EncodeHexTx(*(tc->*get(TxToTag{}))) + "\",\"n_in\":" + std::to_string(tc->*get(NInTag{})) +
+             ",\"amount\":" + std::to_string((tc->*get(AmountTag{})).GetSatoshis());
+    }
+    return r;
+}
+
+// One file for the process, written under a lock; the pending call and the frames are per thread
+// (mt_2_plus_2 and mt_p2pkh run their calls on 8 threads at once).
+struct State {
+    std::mutex m;
+    std::FILE* out = nullptr;
+    bool opened = false;
+    std::map<std::string, unsigned> seq;
+    ~State() { if (out) std::fclose(out); }
+    void write(const std::string& line) {
+        std::lock_guard<std::mutex> g{m};
+        if (!opened) {
+            opened = true;
+            if (const char* p = std::getenv("CPPX_OUT")) out = std::fopen(p, "a");
+        }
+        if (out) { std::fputs(line.c_str(), out); std::fputc('\n', out); std::fflush(out); }
+    }
+    bool on() { return std::getenv("CPPX_OUT") != nullptr; }
+    unsigned next(const std::string& key) { std::lock_guard<std::mutex> g{m}; return seq[key]++; }
+};
+inline State& state() { static State s; return s; }
+struct Local {
+    std::vector<std::source_location> frames;
+    std::string pending;
+    void flush() { if (!pending.empty()) { state().write(pending + ",\"expect\":null}"); pending.clear(); } }
+    ~Local() { flush(); }
+};
+inline Local& local() { thread_local Local l; return l; }
+
+// A helper that leads to a recorded call holds a Frame for its caller's line,
+// so an entry cites the line of the test body the check was written on.
+struct Frame {
+    explicit Frame(std::source_location l) { local().frames.push_back(l); }
+    ~Frame() { local().frames.pop_back(); }
+    Frame(const Frame&) = delete;
+    Frame& operator=(const Frame&) = delete;
+};
+
+// The record's head: where the call is cited, its index among the case's calls cited at that line.
+inline std::string head(std::source_location at, const char* kind) {
+    const auto& tc = boost::unit_test::framework::current_test_case();
+    const auto& fr = local().frames;
+    const unsigned cite = fr.empty() ? at.line() : fr.front().line();
+    std::string chain = "[";
+    for (const auto& f : fr) chain += std::to_string(f.line()) + ",";
+    chain += std::to_string(at.line()) + "]";
+    const unsigned n = state().next(std::string(tc.p_name.get()) + "|" + std::to_string(cite));
+    return "{\"v\":1,\"kind\":\"" + std::string(kind) + "\",\"file\":\"" + rel(at.file_name()) + "\",\"case\":\"" +
+           tc.p_name.get() + "\",\"line\":" + std::to_string(cite) + ",\"seq\":" + std::to_string(n) +
+           ",\"chain\":" + chain;
+}
+
+inline std::string eval_params_json(const eval_script_params& p) {
+    return "{\"max_ops\":" + std::to_string(p.MaxOpsPerScript()) +
+           ",\"max_num_len\":" + std::to_string(p.MaxScriptNumLength()) +
+           ",\"max_script_size\":" + std::to_string(p.MaxScriptSize()) +
+           ",\"max_pubkeys_multisig\":" + std::to_string(p.MaxPubKeysPerMultiSig()) + "}";
+}
+
+inline std::optional<ScriptError> eval(std::source_location at,
+                                       const eval_script_params& params,
+                                       const task::CCancellationToken& token,
+                                       LimitedStack& stack,
+                                       const CScript& script,
+                                       uint32_t flags,
+                                       const BaseSignatureChecker& checker) {
+    Local& lo = local();
+    lo.flush();
+    const bool on = state().on();
+    std::string rec;
+    if (on) {
+        rec = head(at, "evalscript") + ",\"flags\":" + std::to_string(flags) + ",\"params\":" + eval_params_json(params) +
+              checker_json(checker) +
+              ",\"script\":" + elem(script.data(), script.size()) +
+              ",\"stack_in\":" + stack_json(stack) +
+              ",\"stack_limit\":" + std::to_string(stack_limit(stack)) +
+              ",\"combined_in\":" + std::to_string(stack.getCombinedStackSize());
+    }
+    const auto r = ::EvalScript(params, token, stack, script, flags, checker);
+    if (on) {
+        rec += ",\"observed\":{\"status\":" + (r ? std::to_string(static_cast<int>(*r)) : std::string("null")) +
+               ",\"stack\":" + stack_json(stack) + "}";
+        lo.pending = rec;
+    }
+    return r;
+}
+
+inline std::optional<ScriptError> verify(std::source_location at,
+                                         const verify_script_params& params,
+                                         const task::CCancellationToken& token,
+                                         const CScript& scriptSig,
+                                         const CScript& scriptPubKey,
+                                         uint32_t flags,
+                                         const BaseSignatureChecker& checker) {
+    Local& lo = local();
+    lo.flush();
+    const bool on = state().on();
+    std::string rec;
+    if (on) {
+        std::string p = eval_params_json(params.EvalScriptParams());
+        p.pop_back();
+        p += ",\"max_stack_memory\":" + std::to_string(params.MaxStackMemoryUsage()) + "}";
+        rec = head(at, "verifyscript") + ",\"flags\":" + std::to_string(flags) + ",\"params\":" + p +
+              checker_json(checker) +
+              ",\"script_sig\":" + elem(scriptSig.data(), scriptSig.size()) +
+              ",\"script_pubkey\":" + elem(scriptPubKey.data(), scriptPubKey.size());
+    }
+    const auto r = ::VerifyScript(params, token, scriptSig, scriptPubKey, flags, checker);
+    if (on) {
+        rec += ",\"observed\":{\"status\":" + (r ? std::to_string(static_cast<int>(*r)) : std::string("null")) + "}";
+        lo.pending = rec;
+    }
+    return r;
+}
+
+inline void expect(const Expect& e) {
+    Local& lo = local();
+    if (lo.pending.empty()) return;
+    std::string j = "{";
+    auto add = [&](const std::string& k, const std::string& v) {
+        if (j.size() > 1) j += ",";
+        j += "\"" + k + "\":" + v;
+    };
+    if (e.error) add("status", std::to_string(static_cast<int>(*e.error)));
+    if (e.fails) add("fails", "true");
+    if (e.stack_size) add("stack_size", std::to_string(*e.stack_size));
+    if (e.stack) {
+        std::string s = "[";
+        for (size_t i = 0; i < e.stack->size(); ++i) s += (i ? "," : "") + elem((*e.stack)[i]);
+        add("stack", s + "]");
+    }
+    if (e.stack_top) add("stack_top", elem(*e.stack_top));
+    if (e.top_len) add("top_len", std::to_string(*e.top_len));
+    if (!e.bytes_at.empty()) {
+        std::string s = "[";
+        for (size_t i = 0; i < e.bytes_at.size(); ++i) {
+            const auto& [ix, off, b] = e.bytes_at[i];
+            s += (i ? "," : "") + std::string("[") + std::to_string(ix) + "," + std::to_string(off) + ",\"" + hex(&b, 1) + "\"]";
+        }
+        add("bytes_at", s + "]");
+    }
+    if (e.stack_limit) add("stack_limit", std::to_string(*e.stack_limit));
+    if (e.note) add("note", "\"" + std::string(e.note) + "\"");
+    for (const auto* f : {&e.elems_at, &e.nums_at}) {
+        if (f->empty()) continue;
+        std::string s = "[";
+        for (size_t i = 0; i < f->size(); ++i)
+            s += (i ? "," : "") + std::string("[") + std::to_string((*f)[i].first) + "," + elem((*f)[i].second) + "]";
+        add(f == &e.elems_at ? "elems_at" : "nums_at", s + "]");
+    }
+    if (e.drawn) add("drawn", "\"" + std::string(e.drawn) + "\"");
+    if (e.loop) add("loop", std::to_string(*e.loop));
+    if (e.concurrent) add("concurrent", "true");
+    state().write(lo.pending + ",\"expect\":" + j + "}}");
+    lo.pending.clear();
+}
+
+// A predicate the check asserts (a standardness or script predicate, or FindAndDelete), written before the
+// check: its name, the layer it belongs to ("policy", "consensus" or "both"), its arguments and what the check
+// asserts it returns. The run's receipt is the evidence the reference returned it (every assertion passed).
+inline std::string js(const uint8_t* p, size_t n) { return elem(p, n); }
+inline std::string js(const CScript& s) { return elem(s.data(), s.size()); }
+inline std::string js(const bytes& v) { return elem(v); }
+inline std::string js(const char* s) { return "\"" + std::string(s) + "\""; }
+inline std::string js(const std::string& s) { return "\"" + s + "\""; }  // a hex string or a name, no escaping needed
+inline std::string js(bool b) { return b ? "true" : "false"; }
+template <typename T>
+    requires(std::is_integral_v<T> && !std::is_same_v<T, bool>)
+inline std::string js(T n) { return std::to_string(n); }
+// a big number in decimal, as a JSON string (bint's own printer, big_int.h)
+inline std::string dec(const bsv::bint& n) { std::ostringstream o; o << n; return "\"" + o.str() + "\""; }
+inline std::vector<bytes> stack_bytes(const LimitedStack& s) {
+    std::vector<bytes> r;
+    for (size_t i = 0; i < s.size(); ++i) r.push_back(s.at(i).GetElement());
+    return r;
+}
+// ProtocolEra's names in its order (protocol_era.h:28-34)
+inline const char* era(int e) {
+    static const char* names[] = {"Unknown", "PreGenesis", "PostGenesis", "PostChronicle"};
+    return e >= 0 && e < 4 ? names[e] : "?";
+}
+// keys a test draws at run time, registered by the hook after the draw: a call whose scripts carry one is marked
+inline std::vector<std::pair<bytes, const char*>>& drawn_keys() { static std::vector<std::pair<bytes, const char*>> k; return k; }
+inline const char* drawn_in(const CScript& a, const CScript& b) {
+    for (const auto& [k, note] : drawn_keys())
+        for (const CScript* s : {&a, &b})
+            if (std::search(s->begin(), s->end(), k.begin(), k.end()) != s->end()) return note;
+    return nullptr;
+}
+inline std::string obj(std::initializer_list<std::pair<const char*, std::string>> kv) {
+    std::string r = "{";
+    for (const auto& [k, v] : kv) r += (r.size() > 1 ? "," : "") + std::string("\"") + k + "\":" + v;
+    return r + "}";
+}
+// a number as the script number a script would push (its minimal encoding), and a CScriptNum with its
+// representation (int64 or bint) and its width
+inline std::string num(int64_t v) { return elem(CScriptNum{v, CScriptNum::INT64_SERIALIZED_SIZE}.getvch()); }
+inline std::string sn(const CScriptNum& n) {
+    return obj({{"vch", elem(n.getvch())}, {"repr", n.index() == 0 ? "\"int64\"" : "\"bint\""},
+                {"max_len", std::to_string(n.max_length())}});
+}
+inline void predicate(std::source_location at, const char* name, const char* layer, const std::string& args,
+                      const std::string& asserted, const char* note = nullptr, const char* drawn = nullptr) {
+    Local& lo = local();
+    lo.flush();
+    if (!state().on()) return;
+    std::string rec = head(at, "predicate") + ",\"predicate\":\"" + name + "\",\"layer\":\"" + layer +
+                      "\",\"args\":" + args + ",\"expect\":" + asserted;
+    if (note) rec += ",\"note\":\"" + std::string(note) + "\"";
+    if (drawn) rec += ",\"drawn\":\"" + std::string(drawn) + "\"";
+    state().write(rec + "}");
+}
+
+// From sitting 7: a transaction as hex, the policy values a standardness predicate reads at a height
+// (script/standard.cpp:353-374, 427-500; policy/policy.cpp:162-190), as numbers, and the five values of
+// verify_script_params (interpreter.h:176-194).
+inline std::string tx(const CTransaction& t) { return "\"" + EncodeHexTx(t) + "\""; }
+inline std::string tx(const CMutableTransaction& t) { return tx(CTransaction(t)); }
+inline std::string policy(const ConfigScriptPolicy& p, int32_t height) {
+    const ProtocolEra e = GetProtocolEra(p, height);
+    return obj({{"genesis_height", js(p.GetGenesisActivationHeight())},
+                {"chronicle_height", js(p.GetChronicleActivationHeight())},
+                {"era_at_height", js(era(static_cast<int>(e)))},
+                {"max_tx_size", js(p.GetMaxTxSize(e, false))},
+                {"data_carrier", js(p.GetDataCarrier())},
+                {"data_carrier_size", js(p.GetDataCarrierSize())},
+                {"permit_bare_multisig", js(p.GetPermitBareMultisig())}});
+}
+inline std::string verify_params_json(const verify_script_params& params) {
+    std::string p = eval_params_json(params.EvalScriptParams());
+    p.pop_back();
+    return p + ",\"max_stack_memory\":" + std::to_string(params.MaxStackMemoryUsage()) + "}";
+}
+
